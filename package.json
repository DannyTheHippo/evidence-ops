{
  "name": "evidence-ops",
  "version": "0.1.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "build": "NODE_ENV=production nest build",
    "start": "OTEL_SERVICE_NAME=evidence-ops-api nest start",
    "start:dev": "OTEL_SERVICE_NAME=evidence-ops-api nest start --watch",
    "start:prod": "NODE_ENV=production OTEL_SERVICE_NAME=evidence-ops-api node --import ./dist/instrumentation.js dist/main",
    "--- CHECKS ---": "--------------------------------",
    "checks": "npm run format && npm run lint && npm run tsc && npm run test && npm run test:e2e",
    "checks:ci": "npm run format:check && npm run lint:check && npm run tsc && npm run test && npm run test:e2e",
    "checks:web": "npm --prefix web run lint && npm --prefix web run typecheck && npm --prefix web run test",
    "tsc": "tsc --noEmit",
    "format": "prettier --write \"{src,test,migrations,scripts,eval}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test,migrations,scripts,eval}/**/*.ts\"",
    "lint": "eslint \"{src,test,migrations,scripts,eval}/**/*.ts\" --fix && markdownlint-cli2 --fix",
    "lint:check": "eslint \"{src,test,migrations,scripts,eval}/**/*.ts\" && markdownlint-cli2",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.e2e.config.ts",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.integration.config.ts",
    "--- OPENAPI ---": "--------------------------------",
    "openapi:generate": "NODE_ENV=local npx ts-node -P tsconfig.ts-node.json scripts/generate-openapi.ts && npm --prefix web run openapi:types",
    "openapi:check": "npm run openapi:generate && git diff --exit-code -- web/src/api/openapi.json web/src/api/schema.ts",
    "--- DB MIGRATIONS ---": "--------------------------------",
    "migrate:up": "npx tsx ./node_modules/migrate-mongo/bin/migrate-mongo.js up",
    "migrate:down": "npx tsx ./node_modules/migrate-mongo/bin/migrate-mongo.js down",
    "smoke:providers": "npx ts-node -P tsconfig.ts-node.json scripts/smoke-providers.ts",
    "--- FIXTURES ---": "--------------------------------",
    "fixtures:generate": "npx tsx scripts/fixtures/cli.ts",
    "--- EVAL ---": "--------------------------------",
    "eval": "npx ts-node -P tsconfig.ts-node.json eval/run.ts",
    "--- EXPERIMENTS ---": "--------------------------------",
    "experiment:verifier": "npx ts-node -P tsconfig.ts-node.json scripts/experiments/verifier/cli.ts",
    "--- TEMPORAL ---": "--------------------------------",
    "temporal:dev": "temporal server start-dev --db-filename .temporal/dev.db",
    "worker:dev": "OTEL_SERVICE_NAME=evidence-ops-worker npx ts-node -P tsconfig.ts-node.json -r ./src/instrumentation.ts src/worker/main.ts",
    "mcp:dev": "OTEL_SERVICE_NAME=evidence-ops-mcp npx ts-node -P tsconfig.ts-node.json -r ./src/instrumentation.ts src/mcp/main.ts",
    "--- OPERATIONS ---": "--------------------------------",
    "backup:mongo": "bash scripts/backup/mongo-backup.sh",
    "restore:mongo": "bash scripts/backup/mongo-restore.sh",
    "tenant:purge": "npx tsx scripts/tenant-purge.ts",
    "tenant:co-tenant-user": "npx tsx scripts/co-tenant-user.ts",
    "user:revoke-sessions": "npx tsx scripts/revoke-user-sessions.ts",
    "--- DEPS ---": "--------------------------------",
    "deps": "ncu -u && npm i && husky",
    "--- HOOKS ---": "--------------------------------",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@temporalio/activity": "^1.22.0",
    "@temporalio/client": "^1.22.0",
    "@temporalio/worker": "^1.22.0",
    "@temporalio/workflow": "^1.22.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "jszip": "^3.10.1",
    "migrate-mongo": "^14.0.7",
    "mongoose": "^9.9.2",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.2.108",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "xml-js": "^1.6.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.29",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^26.2.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "docx": "^9.7.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "markdownlint-cli2": "^0.23.2",
    "mongodb-memory-server": "^11.2.0",
    "pdfkit": "^0.19.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "js-yaml": "^5.2.2"
  }
}
