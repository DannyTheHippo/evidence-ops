{
  "compilerOptions": {
    "outDir": "./dist",

    // This config is for type-checking and editors, never for producing output: `tsconfig.build.json`
    // is the only one that emits, and it turns this back off. Without it, any bare `tsc` aimed at
    // `eval/` or `scripts/` writes `.js` + `.d.ts` next to the sources (`declaration` is on below),
    // and because `.d.ts` matches the lint glob `{src,test,migrations,scripts,eval}/**/*.ts`, the
    // stray output then fails `lint:check` with parser errors that name the generated file rather
    // than the command that produced it. That happened; this is the structural fix.
    "noEmit": true,

    "lib": ["ESNext"],
    "target": "ESNext",

    "types": ["node", "jest"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "allowJs": false,
    "incremental": true,
    "removeComments": true,
    "strictBindCallApply": true,

    "noImplicitAny": true,
    "strictNullChecks": true,
    // DTOs/Mongoose schema classes are hydrated by class-transformer/Mongoose, never a constructor;
    // strictPropertyInitialization would force `!:` on every field for no real safety gain.
    "strictPropertyInitialization": false,
    "noUnusedLocals": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "skipLibCheck": true,
    "importHelpers": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "migrations/**/*",
    "scripts/**/*",
    "eval/**/*",
    "jest.config.ts",
    "jest.e2e.config.ts",
    "jest.integration.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
