# Build & dependencies
/node_modules
/dist
/build
*.tsbuildinfo
web/node_modules
web/dist

# Generated
/migrations/data/temp/

# Logs
logs
*.log

# OTLP span files — OTEL_CAPTURE_MODEL_CONTENT can attach document text to a span, so an
# accidental commit here is a disclosure risk, not just noise (see otlp-file-span.exporter.ts).
/artifacts/traces/

# Eval results recorded against a dirty working tree. `eval/run.ts` names its output by git sha and
# suffixes `-dirty` when the tree has uncommitted changes, so every run during development writes a
# file into this otherwise-committed directory. Three such recordings had accumulated and one was
# being cited by a walkthrough as if it were current — the suffix marks provenance as untrustworthy,
# which is exactly what should never be committed. Clean-sha results stay tracked deliberately.
/eval/results/*-dirty.json
/eval/results/*-dirty.md

# Environment
.env
.env.local
.env.*.local

# Test output
/coverage
/.nyc_output

# Temp & runtime
.temp
.tmp
.temporal/
pids
*.pid
*.seed
*.pid.lock

# Diagnostics
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Editors & IDEs
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# OS
.DS_Store

# AI assistants
.serena/*
# .claude/ is committed on purpose — the rules, contexts, skills and project-discovery.json
# are shared project configuration, useless if they only exist on one machine. Machine-local
# and regenerable scratch files are excluded by .claude/.gitignore instead of a blanket ignore.
