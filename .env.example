# GLOBAL
NODE_ENV="local"
PORT=3000
LOG_LEVEL="DEBUG"
URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:5173"

# MONGO DB
MONGO_DB_URI="mongodb://localhost:27017/evidence-ops?directConnection=true"
MONGO_MEMORY_SERVER=false

# AUTH
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# THROTTLING
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ANTHROPIC
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# VOYAGE
VOYAGE_API_KEY=""
VOYAGE_MODEL="voyage-4"
VOYAGE_DIMENSIONS=1024

# TEMPORAL
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_TASK_QUEUE="evidence-ops"

# RETRIEVAL
RETRIEVAL_FUSION="server"
