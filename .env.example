# GLOBAL
NODE_ENV="local"
PORT=3000
LOG_LEVEL="DEBUG"
URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:5173"

# MONGO DB
MONGO_DB_URI="mongodb://localhost:27018/evidence-ops?directConnection=true"
MONGO_MEMORY_SERVER=false
MONGO_HOST_PORT=27018

# AUTH
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# THROTTLING
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ANTHROPIC
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# VOYAGE
VOYAGE_API_KEY=""
VOYAGE_MODEL="voyage-4"
VOYAGE_DIMENSIONS=1024
VOYAGE_REQUESTS_PER_MINUTE=3
VOYAGE_MAX_RETRIES=5
VOYAGE_MAX_RETRY_WAIT_MS=300000

# TEMPORAL
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_TASK_QUEUE="evidence-ops"

# RETRIEVAL
RETRIEVAL_FUSION="server"

# TELEMETRY
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_CAPTURE_MODEL_CONTENT=false

# SOURCES
SOURCES_INBOX_DIR="./inbox"
SOURCE_SYNC_INTERVAL_MS=300000
