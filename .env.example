# Secrets and spend ceilings. Copy to `.env` and fill in.
#
# Nothing else belongs here. Every non-secret knob is declared in `docker-compose.yml` for the
# containerized stack, and falls back to its `src/config/environment/environment.config.ts` zod
# default for the host dev loop — so this file stays short enough to audit and safe to talk about.

# AUTH
JWT_SECRET=""

# MODEL PROVIDER
MODEL_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# EMBEDDINGS
VOYAGE_API_KEY=""

# SPEND CEILINGS
MODEL_SPEND_DAILY_LIMIT_USD=5
AGENTIC_MAX_COST_USD=1
